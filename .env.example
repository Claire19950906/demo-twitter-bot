# Twitter 账号 (首次登录需要, 之后用 cookie)
TWITTER_USERNAME=你的用户名
TWITTER_EMAIL=注册邮箱
TWITTER_PASSWORD=密码

# LLM (推荐 DeepSeek, 便宜+中文友好)
# 获取: https://platform.deepseek.com/
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 如果用 OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 如果用 Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxx
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-haiku-latest

# === 可选: Telegram Bot (跑 telegram_bot.py 才需要) ===
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_WATCH_CHATS=  # 留空=所有消息; 或填 chat_id,用逗号分隔
# TELEGRAM_SYSTEM_PROMPT=你是小博, 喜欢分享 AI 工具和读书笔记
# MAX_TG_REPLIES_PER_HOUR=10

# === 可选: 生图 (发图功能才需要) ===
# IMAGE_PROVIDER=openai   # openai / none
# IMAGE_API_KEY=sk-xxxxxxxx
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=dall-e-3
# IMAGE_SIZE=1024x1024

# === 全局: 错别字概率 ===
# TYPO_PROB=0.08

# === 可选: Webhook 通知 (v4 新增) ===
# 全部可选, 不填就不发, 填了自动启用
#
# Slack Incoming Webhook:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXX
#
# 钉钉机器人:
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=XXX
#
# 企业微信机器人:
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=XXX
#
# Telegram 通知 (复用 TELEGRAM_BOT_TOKEN, 只需填 chat_id):
# TELEGRAM_NOTIFY_CHAT_ID=123456789